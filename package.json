{
  "name": "soft-skills-learning-platform",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "node -e \"const fs=require('fs'); if(!fs.existsSync('.next/BUILD_ID')) { console.log('[Platform] Production build not found. Running next build automatically...'); require('child_process').execSync('npm run build', {stdio:'inherit'}); }\"",
    "start": "next start",
    "lint": "next lint",
    "electron": "electron .",
    "electron:dev": "electron .",
    "build:exe": "next build && node ./electron/copy-standalone.js && electron-builder --win"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "next": "14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.apexskill.softskills",
    "productName": "Soft Skills Platform",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/standalone/.next/static/**/*",
      ".next/standalone/public/**/*",
      ".env.local"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Soft Skills Platform",
      "createDesktopShortcut": true
    }
  }
}
